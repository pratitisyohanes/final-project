# ==============================================================
# API
# ==============================================================
# Base URL of the backend API (Express); only VITE_* variables reach the browser
VITE_API_URL=http://localhost:5000/api/v1

# # API production (same domain, proxied by Nginx)
# VITE_API_URL=https://booking.pratitis.net/api/v1

# ==============================================================
# Integration
# ==============================================================
# POS app (pos-pro) shown as "Shop supplies" in the navbar; leave empty to hide the link
VITE_POS_URL=http://localhost:5174
# VITE_POS_URL=https://pos.pratitis.net

# ==============================================================
# Single sign-on (KandangID, sso-pro) - leave empty to keep the email/password form
# ==============================================================
# Register this app once: cd sso-pro/backend && npm run client:web -- booking-web "Booking" "http://localhost:5173"
# VITE_SSO_URL=http://localhost:5002
# VITE_SSO_CLIENT_ID=booking-web
# VITE_SSO_URL=https://sso.pratitis.net
