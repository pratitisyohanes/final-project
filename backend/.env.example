# ==============================================================
# Application
# ==============================================================
# development | test | production
NODE_ENV=development
# Port the Express API listens on
PORT=5000

# ==============================================================
# Database (PostgreSQL)
# ==============================================================
# DB local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=booking_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
# true only for hosted databases that require SSL (Neon, Supabase, Railway)
DB_SSL=false

# # DB docker (backend/docker-compose.yml, exposed on port 5433)
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_DATABASE=booking_db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# # DB production (VPS, only reachable from the server itself)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=booking_db
# DB_USERNAME=booking_user
# DB_PASSWORD=change-me

# Alternative: one connection string; when set it overrides every DB_* value above
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_db

# ==============================================================
# Authentication (JWT)
# ==============================================================
# Signs the short-lived access token; use a long random string (min 16 chars)
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
# Access token lifetime (15m, 1h, ...)
JWT_ACCESS_EXPIRES=15m
# Signs the refresh token; must differ from the access secret
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
# Refresh token lifetime (7d, 30d, ...)
JWT_REFRESH_EXPIRES=7d

# ==============================================================
# Security
# ==============================================================
# Frontend origins allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:5173
# Password hashing cost (4-15); higher is slower and stronger
BCRYPT_ROUNDS=10

# ==============================================================
# Integration (pos-pro)
# ==============================================================
# Shared secret for /api/v1/internal calls from pos-api (min 32 chars, same value in pos-pro/backend/.env)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change-me-internal-key-at-least-32-characters

# ==============================================================
# Login provider (sso-pro auth-service + LDAP)
# ==============================================================
# local = passwords in booking_db (default) · sso = passwords checked by auth-service against OpenLDAP
AUTH_PROVIDER=local
# Only read when AUTH_PROVIDER=sso; auth-service listens on localhost only
# AUTH_SERVICE_URL=http://127.0.0.1:5002
# Printed once by: cd sso-pro/backend && npm run client:create -- booking-api "Booking API" "auth:validate users:read users:write"
# AUTH_CLIENT_ID=booking-api
# AUTH_CLIENT_SECRET=paste-the-secret-shown-by-client-create
# AUTH_TIMEOUT_MS=3000

# ==============================================================
# Two-factor authentication (TOTP, Google Authenticator)
# ==============================================================
# true = every ADMIN must set up an authenticator app on the next login
MFA_ENFORCE_ADMIN=false
# Encrypts TOTP secrets in the database; required when MFA is used (64 hex chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MFA_ENCRYPTION_KEY=
# Name shown in the authenticator app
MFA_ISSUER=ELEFEZ FARM

# ==============================================================
# Single sign-on (KandangID OIDC) - needs AUTH_PROVIDER=sso
# ==============================================================
# With these set, RS256 tokens from KandangID are accepted next to this API's own HS256 tokens.
# Two-factor login then happens on the KandangID page (MFA_* in sso-pro), not here.
# SSO_JWKS_URL=http://127.0.0.1:5002/.well-known/jwks.json
# Must equal PUBLIC_URL of sso-pro
# SSO_ISSUER=http://localhost:5002
SSO_AUDIENCE=booking-api
